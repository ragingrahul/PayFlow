# npx convex dev creates .env.local for your deployment.
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
# CONVEX_DEPLOYMENT is written by the Convex CLI. Never commit .env.local.

# Copilot: choose one server-side provider. Never prefix secrets with NEXT_PUBLIC_.
COPILOT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Alternative Inkeep agent provider:
# COPILOT_PROVIDER=inkeep
# INKEEP_API_KEY=
# INKEEP_BASE_URL=https://api.pilot.inkeep.com
# INKEEP_AGENT_ID=

# Optional payslip delivery. Use a verified Resend sender address.
RESEND_API_KEY=
RESEND_FROM_EMAIL=PayFlow <payroll@example.com>
# Public base URL used in emailed payslip links.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
